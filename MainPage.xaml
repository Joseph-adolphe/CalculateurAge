<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}" Placeholder="Votre nom"/>
            
            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance, Mode=TwoWay}"/>
            
            <HorizontalStackLayout Spacing="10">
                <Button Text="Calculer" Command="{Binding CalculerCommand}"/>
                <Button Text="Effacer" Command="{Binding EffacerCommand}"/>
                <Button Text="Voir Détails (Page 2)" Command="{Binding NaviguerResultatCommand}"/>
            </HorizontalStackLayout>
            
            <VerticalStackLayout IsVisible="{Binding ResultatVisible}" Spacing="5" Margin="0,20,0,0">
                <Label Text="{Binding Resultat}" FontSize="20" FontAttributes="Bold"/>
                <Label Text="{Binding MessageAge}" FontSize="18" TextColor="Gray"/>
                <Label Text="{Binding JoursRestants}" FontSize="16" TextColor="Blue"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
